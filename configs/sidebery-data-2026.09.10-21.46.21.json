	"sidebarCSS": "#root.root{--tabs-font: 10pt sans-serif;--tabs-margin: 0px;--nav-btn-width: 42px;--nav-btn-height: 42px;--tabs-border-radius: 8px;--tabs-height: 36px;--tabs-inner-gap: 10px;--tabs-pinned-width: 42px;--tabs-pinned-height: 42px;--search-height: 36px;--search-icon-width: 42px;--nav-btn-margin: 0px}#root.root{--audio-position: 20px;--audio-size: 16px;--tab-margin: 3px;--sidebar-width: 42px}.NavigationBar[data-layout=inline] .main-items .nav-item[data-index=\"-1\"][data-active=true]{opacity:1;transform:scale(1, 1)}.NavigationBar .nav-item{width:var(--tabs-height);height:var(--tabs-height);border-radius:var(--tabs-border-radius);margin:0 var(--tab-margin)}.NavigationBar .nav-item[data-active=true]{box-shadow:0px 2px 5px var(--color),inset 0 0 0 1px hsla(0,0%,100%,.1490196078),inset 0 1px 1px var(--color)}.NavigationBar .static-btns{transition:opacity .5s linear}.PinnedTabsBar{flex-wrap:nowrap !important}.PinnedTabsBar .Tab .body{width:var(--tabs-height) !important;height:var(--tabs-height) !important}.Tab .body{margin:0 var(--tab-margin);width:unset;transition:box-shadow .25s ease,background .25s ease}.Tab .body .fav{margin:0 var(--tabs-inner-gap) !important}.Tab .body .t-box .title{transform:none}.Tab[data-active=true] .body{background:linear-gradient(125deg, rgba(255, 255, 255, 0.1490196078), rgba(0, 0, 0, 0.1490196078));box-shadow:-2px -3px 6px hsla(0,0%,100%,.2),2px 3px 7px rgba(0,0,0,.2509803922),inset 0 0 0 1px hsla(0,0%,100%,.1490196078),inset 0 1px 1px hsla(0,0%,100%,.2)}.audio{top:var(--audio-position) !important;left:var(--audio-position) !important;height:var(--audio-size) !important;width:var(--audio-size) !important;background-color:rgba(0,0,0,0) !important;box-shadow:none !important}#root:not(:hover)[data-tabs-tree-lvl-marks=true] .Tab[data-pin=false]:not([data-lvl=\"0\"]) .body:after{display:none}#root:not(:hover) .NavigationBar[data-layout=inline] .static-btns{opacity:0;z-index:-1;transform:scale(0, 0)}#root:not(:hover) .TabsPanel{--tabs-indent: 0px}.BottomBar{bottom:var(--nav-btn-height) !important}.BottomBar .tool-btn{min-width:var(--tabs-height)}/*# sourceMappingURL=styleEditor.css.map */",
